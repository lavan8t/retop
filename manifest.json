{
  "manifest_version": 3,
  "name": "retop",
  "description": "uni portal done better.",
  "version": "0.6.0",

  "permissions": ["unlimitedStorage", "downloads", "storage"],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self';"
  },


  "host_permissions": [
    "https://vtop.vit.ac.in/*",
    "https://vtopcc.vit.ac.in/*",
    "https://getretop.web.app/*",
    "https://barcode.tec-it.com/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://vtop.vit.ac.in/*",
        "https://vtopcc.vit.ac.in/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://vtop.vit.ac.in/*",
        "https://vtopcc.vit.ac.in/*"
      ],
      "js": ["injected.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://getretop.web.app/*"
      ],
      "js": ["webBridge.js"],
      "run_at": "document_start"
    }
  ],

  "background": {
    "service_worker": "background.js"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "injected.js",
        "webBridge.js",
        "login.js",
        "dashboard.js",
        "offline.js",
        "offline.html",
        "chunk-*.js",
        "style.css",
        "login.css",
        "vtop-dark.css",        "fonts/gsf.subset.woff2",
        "fonts/gsf.subset2.woff2",
        "fonts/*",
        "assets/vitLogo.svg",
        "assets/*",
        "pdf.js/*",
        "pdf.js/pdf.worker.min.mjs"
      ],
      "matches": [
        "https://vtop.vit.ac.in/*",
        "https://vtopcc.vit.ac.in/*",
        "https://getretop.web.app/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "retop-ext@vit.ac.in",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
