{
  "manifest_version": 3,
  "name": "re.top",
  "description": "college portal made better.",
  "version": "0.2.0",

  "permissions": [],

  "host_permissions": ["https://vtop.vit.ac.in/*"],

  "content_scripts": [
    {
      "matches": ["https://vtop.vit.ac.in/*"],
      "js": ["dist/content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/injected.js",
        "dist/style.css",
        "dist/assets/vit.svg"
      ],
      "matches": ["https://vtop.vit.ac.in/*"]
    }
  ]
}
