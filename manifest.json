{
  "manifest_version": 3,
  "name": "retop",
  "description": "college portal made better.",
  "version": "0.3.0",

  "permissions": ["storage", "activeTab", "unlimitedStorage", "downloads", "identity"],

  "host_permissions": [
    "https://vtop.vit.ac.in/vtop/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://vtop.vit.ac.in/vtop/*"
      ],
      "js": ["dist/content.js"],
      "run_at": "document_start"
    }
  ],

  "background": {
    "service_worker": "dist/background.js"
  },


  "web_accessible_resources": [
    {
      "resources": [
        "dist/injected.js",
        "dist/style.css",
        "dist/login.css",
        "dist/offline.html",
        "dist/fonts/gsf.subset.woff2",
        "dist/fonts/gsf.subset2.woff2",
        "dist/assets/vitLogo.svg"
      ],
      "matches": ["https://vtop.vit.ac.in/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png"
    }
  }
}
