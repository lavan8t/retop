{
  "manifest_version": 3,
  "name": "retop",
  "description": "college portal made better.",
  "version": "0.3.0",

  "permissions": ["storage"],

  "host_permissions": [
    "https://vtop.vit.ac.in/vtop/content/*",
    "https://vtop.vit.ac.in/vtop/login*",
    "https://vtop.vit.ac.in/vtop/open/page*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://vtop.vit.ac.in/vtop/content/*",
        "https://vtop.vit.ac.in/vtop/login*"
      ],
      "js": ["dist/content.js"],
      "run_at": "document_start"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "dist/injected.js",
        "dist/style.css",
        "dist/login.css",
        "dist/fonts/gsf.subset.woff2",
        "dist/fonts/gsf.subset2.woff2",
        "dist/assets/vitLogo.svg"
      ],
      "matches": ["https://vtop.vit.ac.in/*"]
    }
  ]
}
