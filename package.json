{
  "name": "vtop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "bun ./node_modules/typescript/lib/tsc.js --noEmit && bun run build.ts",
    "build:prod": "bun ./node_modules/typescript/lib/tsc.js --noEmit && bun run build.ts --prod",
    "build:copy": "bun run build && bun scripts/copy-dist.ts",
    "copy:dist": "bun scripts/copy-dist.ts",
    "serve:idcard": "bun run scripts/serve-idcard.ts",
    "css:watch": "bun ./node_modules/@tailwindcss/cli/dist/index.mjs -i src/input.css -o dist/style.css --watch"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "@nine-thirty-five/material-symbols-react": "^2.1.2",
    "@quicktoolsone/pdf-compress": "^2.0.0",
    "idb-keyval": "^6.3.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "@types/bun": "latest",
    "@types/chrome": "^0.1.36",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3"
  }
}
