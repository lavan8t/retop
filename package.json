{
  "name": "retop",
  "version": "0.6.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "bun": ">=1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lavan8t/retop.git"
  },
  "scripts": {
    "test": "bun test",
    "lt": "bun ./node_modules/typescript/lib/tsc.js --noEmit",
    "audit": "bun audit --ignore=GHSA-vfj7-8cjw-p6xm",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/*.ts\" \"*.html\" --no-error-on-unmatched-pattern",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/*.ts\" \"*.html\" --no-error-on-unmatched-pattern",
    "build": "bun ./node_modules/typescript/lib/tsc.js --noEmit && bun run build.ts",
    "build:prod": "bun ./node_modules/typescript/lib/tsc.js --noEmit && bun run build.ts --prod",
    "serve:idcard": "bun run scripts/serve-idcard.ts",
    "css:watch": "bun ./node_modules/@tailwindcss/cli/dist/index.mjs -i src/input.css -o dist/style.css --watch"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "@nine-thirty-five/material-symbols-react": "^2.1.2",
    "@quicktoolsone/pdf-compress": "^2.0.0",
    "idb-keyval": "^6.3.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@tailwindcss/cli": "^4.0.0",
    "@types/bun": "1.4.3",
    "@types/chrome": "^0.1.36",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3"
  }
}
